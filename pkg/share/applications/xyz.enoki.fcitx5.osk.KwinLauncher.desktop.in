[Desktop Entry]
Name=Fcitx 5 Osk JA Kwin Launcher
GenericName=Input Method
Comment=An Input Method to Start fcitx5 and fcitx5-osk-ja in Kwin Wayland.
Exec=@INSTALL_BIN_DIR@/fcitx5-osk-ja-kwin-launcher --fcitx5-reopen
Icon=xyz.enoki.fcitx5.osk
Terminal=false
Type=Application
Categories=System;Utility;
StartupNotify=false
NoDisplay=true
OnlyShowIn=KDE
X-KDE-StartupNotify=false
X-KDE-Wayland-VirtualKeyboard=true
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
